from urllib.parse import quote

sys.path.insert(0, str(Path(__file__).resolve().parent))
import assets  # noqa: E402
from install import (  # noqa: E402
    SERVICE_GID,
    SERVICE_UID,
    Host,
    camera_devices,
    check_settings,
    enabled_services,
    finite_json_number,
    load_services,
    parse_settings,
    unique_json_object,
)

WATCHER = "mg400-gripper-collector.path"
CAMERA_PORT = 1985
PRELOAD = "http://127.0.0.1:1984/api/preload"
PASSED = ("TERM", "COLORTERM", "LANG", "LC_ALL", "LC_CTYPE")
BACKUP_OWNER = (0, 0)
ORCHESTRATOR_COMMANDS = {"run", "rehearse", "runs", "station"}
STATION_ACTIONS = {"save", "list", "show", "rm"}
STATION_SETTINGS = {"MG400_ORCH_STATIONS_FILE"} | {
    f"MG400_ORCH_{axis}_{side}_{'DEG' if axis == 'R' else 'MM'}"
    for axis in ("X", "Y", "Z", "R")
    for side in ("MIN", "MAX")
}
STATION_TEACH_SETTINGS = STATION_SETTINGS | {
    "MG400_ORCH_TOOL_FILE",
    "MG400_ORCH_ROBOT_URL",
    "MG400_ORCH_ROBOT_TOKEN",
    "MG400_ORCH_TIMEOUT_S",
}
ORCHESTRATOR_SERVICES = ("ROBOT", "STAGE", "THERMAL", "VISION", "FURNACE", "MICROSCOPE")
ORCHESTRATOR_DATA = {"MG400_ORCH_RUNS_DIR"}
ORCHESTRATOR_SETTINGS = (
    ORCHESTRATOR_DATA
    | {"MG400_ORCH_TIMEOUT_S"}
    | {
        f"MG400_ORCH_{service}_{suffix}"
        for service in ORCHESTRATOR_SERVICES
        for suffix in ("URL", "TOKEN")
    }
)


def furnace_state(settings, *, connection_factory=http.client.HTTPConnection, clock=time.monotonic):
    """Read bounded live status directly, without proxies or redirects.

    This is an advisory check before systemctl, not a lease held across shutdown.
    A new sequence can start after this read. Operators must coordinate shutdown.
    Socket operations time out after 2 seconds. Body reads also check a 2-second
    deadline between chunks. Header and transfer-framing reads use socket timeouts, not a total deadline.
    """
    bind = settings.get("MG400_FURNACE_BIND") or "127.0.0.1"
    if bind != "localhost":
        address = ipaddress.ip_address(bind)
        if "%" in bind:
            raise ValueError("Scoped furnace bind addresses are not supported by the guard")
        bind = str(address)
    bind = {"0.0.0.0": "127.0.0.1", "::": "::1"}.get(bind, bind)
    port = int(settings.get("MG400_FURNACE_PORT") or 8769)
    if not 1 <= port <= 65535:
        raise ValueError("Invalid furnace port")
    base = settings.get("MG400_FURNACE_BASE_PATH") or "/"
    if (
        not base.startswith("/")
        or any(part in base for part in ("?", "#", "//"))
        or ".." in base.split("/")
        or any(ord(character) < 32 or ord(character) == 127 for character in base)
    ):
        raise ValueError("Invalid furnace base path")
    token = settings.get("MG400_FURNACE_TOKEN") or ""
    if len(token) < 24 or any(not 32 <= ord(character) <= 126 for character in token):
        raise ValueError("Set a valid MG400_FURNACE_TOKEN before the status check")
    connection = connection_factory(bind, port, timeout=2)
    try:
        connection.request(
            "GET",
            quote(base.rstrip("/"), safe="/-._~") + "/api/state",
            headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
        )
        response = connection.getresponse()
        if response.status != 200:
            raise ValueError(f"Furnace status returned HTTP {response.status}")
        if response.getheader("Content-Type", "").split(";")[0].strip() != "application/json":
            raise ValueError("Furnace status is not JSON")
        deadline, payload = clock() + 2, bytearray()
        while True:
            if clock() >= deadline:
                raise ValueError("Furnace status body exceeded the read deadline")
            chunk = response.read1(262145 - len(payload))
            if not chunk:
                break
            payload.extend(chunk)
            if len(payload) > 262144:
                raise ValueError("Furnace status exceeds the response size limit")
        return json.loads(
            payload,
            object_pairs_hook=unique_json_object,
            parse_float=finite_json_number,
            parse_constant=finite_json_number,
        )
    finally:
        connection.close()


def check_furnace_shutdown(settings, *, read_state=furnace_state):
    """Refuse running/cooling sequences and unknown live state before any mutation."""
    state = read_state(settings)
    if (
        not isinstance(state, dict)
        or state.get("service") != "furnace"
        or state.get("connected") is not True
        or state.get("locked") is not False
        or "fault" not in state
        or state["fault"] is not None
    ):
        raise ValueError("Furnace state is unavailable, disconnected, or locked")
    sequence = state.get("sequence")
    if not isinstance(sequence, dict) or type(sequence.get("running")) is not bool:
        raise ValueError("Furnace sequence state is missing or ambiguous")
    phase = sequence.get("phase")
    running = sequence["running"]
    if phase not in ("idle", "manual", "ramping", "holding", "cooling", "complete", "stopped"):
        raise ValueError("Furnace sequence phase is unknown")
    if running != (phase in ("ramping", "holding")):
        raise ValueError("Furnace sequence state is inconsistent")
    if running or phase == "cooling":
        raise ValueError("A furnace sequence or its cooling gas plan is active")


def orchestrator(host, argv, execvpe):
    """Dispatch only recipe commands, without changing the administrative root gate."""
    root = os.geteuid() == 0
    if argv[0] == "station" and (len(argv) < 2 or argv[1] not in STATION_ACTIONS):
        print("Usage: labctl station {save,list,show,rm} ...", file=sys.stderr)
        return 2
    if not root and (
        os.getuid() != SERVICE_UID
        or os.geteuid() != SERVICE_UID
        or os.getgid() != SERVICE_GID
        or os.getegid() != SERVICE_GID
    ):
        print("Run recipe commands as UID/GID 1000, or through sudo labctl.", file=sys.stderr)
        return 1
    try:
        if root:
            # Rehearsal must not load production settings, even before dropping UID.
            settings = parse_settings(host.settings.read_text()) if argv[0] != "rehearse" else {}
        else:
            settings = os.environ
        allowed = ORCHESTRATOR_SETTINGS if argv[0] == "run" else ORCHESTRATOR_DATA
        if argv[0] == "station":
            allowed = STATION_TEACH_SETTINGS if argv[1] == "save" else STATION_SETTINGS
        environment = {
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            **{key: os.environ[key] for key in PASSED if key in os.environ},
            **{key: value for key, value in settings.items() if key in allowed and value},
        }
        program = str(host.code.absolute() / ".venv/bin/python")
        command = [program, "-I", "-m", "orchestrator", *argv]
        if root:
            user = pwd.getpwuid(SERVICE_UID).pw_name
            group = grp.getgrgid(SERVICE_GID).gr_name
            runuser = shutil.which("runuser", path="/usr/sbin:/usr/bin:/sbin:/bin")
            if runuser is None:
                raise FileNotFoundError("runuser is missing. Install util-linux.")
            execvpe(
                runuser,
                ["runuser", "--pty", "-u", user, "-g", group, "--", *command],
                environment,
            )
        else:
            execvpe(program, command, environment)
    except (OSError, ValueError, KeyError) as error:
        print(f"Cannot start recipe command: {error}", file=sys.stderr)
        return 1
    return 0


def _file_state(info):
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def _archive_entry(
    archive, parent, name, target, destination, *, skip=(), ancestors=(), expected=None
):
    """Pin each source inode before reading; never open a symlink or device."""
    entry = os.open(name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
    try:
        info = os.fstat(entry)
        if expected is not None and stat.S_IFMT(info.st_mode) != expected:
            raise ValueError(f"Unexpected backup source type: {target}")
        identity = (info.st_dev, info.st_ino)
        member = tarfile.TarInfo(target)
        member.uid, member.gid = info.st_uid, info.st_gid
        member.mode, member.mtime = stat.S_IMODE(info.st_mode), info.st_mtime
        if stat.S_ISDIR(info.st_mode):
            if identity == destination or identity in ancestors:
                raise ValueError(
                    f"Backup source contains its destination or a directory cycle: {target}"
                )
            member.type = tarfile.DIRTYPE
            directory = os.open(".", os.O_RDONLY | os.O_DIRECTORY, dir_fd=entry)
            try:
                archive.addfile(member)
                for child in sorted(os.listdir(directory)):
                    if child not in skip:
                        _archive_entry(
                            archive,
                            directory,
                            child,
                            f"{target}/{child}",
                            destination,
                            ancestors=(*ancestors, identity),
                        )
                if _file_state(os.fstat(directory)) != _file_state(info):
                    raise ValueError(f"Backup source changed while reading: {target}")
            finally:
                os.close(directory)
        elif stat.S_ISREG(info.st_mode):
            member.size = info.st_size
            # O_PATH above cannot activate a device. Reopen only this pinned regular inode.
            reader = os.open(f"/proc/self/fd/{entry}", os.O_RDONLY | os.O_CLOEXEC)
            with os.fdopen(reader, "rb") as stream:
                if _file_state(os.fstat(stream.fileno())) != _file_state(info):
                    raise ValueError(f"Backup source changed before reading: {target}")
                archive.addfile(member, stream)
                if _file_state(os.fstat(stream.fileno())) != _file_state(info):
                    raise ValueError(f"Backup source changed while reading: {target}")
        else:
            raise ValueError(f"Backup source is not a regular file or directory: {target}")
    finally:
        os.close(entry)


def backup(host, output):
    """Publish a private, complete tar without overwriting an existing path."""
    output = Path(output).absolute()
    if ".." in output.parts:
        raise ValueError("Parent traversal is not allowed in backup paths")
    if output == host.settings.absolute() or output.is_relative_to(host.data.absolute()):
        raise ValueError("Backup destination must be outside the backed-up paths")
    with assets._directory(output.parent) as directory:
        parent = os.fstat(directory)
        if parent.st_uid != BACKUP_OWNER[0] or parent.st_mode & 0o022:
            raise ValueError(
                "Backup directory must be root-owned and not writable by group or others"
            )
        try:
            os.stat(output.name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise FileExistsError(f"Backup destination already exists: {output}")
        temporary = f".mg400-backup-{secrets.token_hex(16)}"
        os.mkdir(temporary, 0o700, dir_fd=directory)
        try:
            stage = os.open(
                temporary, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory
            )
            try:
                os.fchown(stage, *BACKUP_OWNER)
                os.fchmod(stage, 0o700)
                fd = os.open(
                    "archive.tar",
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                    0o600,
                    dir_fd=stage,
                )
                try:
                    with os.fdopen(fd, "wb") as stream:
                        os.fchown(stream.fileno(), *BACKUP_OWNER)
                        os.fchmod(stream.fileno(), 0o600)
                        with tarfile.open(
                            fileobj=stream, mode="w", format=tarfile.PAX_FORMAT
                        ) as archive:
                            for source, target, skip, expected in (
                                (host.settings, "etc/mg400/mg400.env", (), stat.S_IFREG),
                                (host.data, "var/lib/mg400", ("locks",), stat.S_IFDIR),
                            ):
                                with assets._directory(source.parent) as source_parent:
                                    _archive_entry(
                                        archive,
                                        source_parent,
                                        source.name,
                                        target,
                                        (parent.st_dev, parent.st_ino),
                                        skip=skip,
                                        expected=expected,
                                    )
                        stream.flush()
                        os.fsync(stream.fileno())
                    # link() fails atomically if any file, directory, or symlink now exists.
                    os.link(
                        "archive.tar",
                        output.name,
                        src_dir_fd=stage,
                        dst_dir_fd=directory,
                        follow_symlinks=False,
                    )
                finally:
                    with contextlib.suppress(FileNotFoundError):
                        os.unlink("archive.tar", dir_fd=stage)
            finally:
                os.close(stage)
        finally:
            os.rmdir(temporary, dir_fd=directory)


def units(names, action, services):
    if "all" in names:
        names = list(services)
    result = []
    for name in names:
        # Starting the preview also starts the capture. Stopping either stops both.
        chosen = services[name][:1] if action == "start" else services[name]
        result.extend(unit for unit in chosen if unit not in result)
    return result


def unit_states(run, chosen):
    """Return {unit: "ActiveState (SubState)"} for the units that systemd knows."""
    shown = run(
        ["systemctl", "show", "--property=Id,ActiveState,SubState", *chosen],
        capture_output=True,
        text=True,
        check=False,
    )
    states = {}
    for block in shown.stdout.strip().split("\n\n"):
        values = dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
        states[values.get("Id")] = f"{values.get('ActiveState')} ({values.get('SubState')})"
    return states


def status(run, out, services):
    rows = [(name, unit) for name, chosen in services.items() for unit in chosen]
    rows.append(("collector", WATCHER))
    states = unit_states(run, [unit for _, unit in rows])
    for name, unit in rows:
        print(f"{name:<10} {unit:<34} {states.get(unit, 'unknown')}", file=out)
    return 0


def camera_check(host, devices, run, out, services):
    """Check the cameras from the USB devices up to the capture streams. Return 0 if all work.

    A service in the active state only shows that its process runs, so check the devices first.
    """
    if not devices:
        print("Cameras are off: MG400_CAMERA_DEVICES is empty.", file=out)
        return 0
    missing = []
    for number, device in enumerate(devices, 1):
        path = host.dev / Path(device).relative_to("/dev")
        if path.exists():
            print(f"camera{number}  ok       {device} -> /dev/{path.resolve().name}", file=out)
        else:
            print(f"camera{number}  missing  {device}", file=out)
            missing.append(device)
    found = sorted(host.dev.glob("v4l/by-path/*-video-index0"))
    others = [f"/dev/{path.relative_to(host.dev)}" for path in found]
    others = [device for device in others if device not in devices]
    for device in others:
        print(f"other    present  {device}", file=out)
    if missing:
        if others:
            print("A camera is on another USB port. Connect it to its configured port.", file=out)
        elif not found:
            print(
                "No camera is detected. Check the USB hub, its cable and power: lsusb -t", file=out
            )
        else:
            print("Check the cable of each missing camera: lsusb -t", file=out)
        print("Restarting the camera services does not fix a missing USB device.", file=out)
        return 1

    states = unit_states(run, services["camera"])
    for unit in services["camera"]:
        print(f"service  {unit:<30} {states.get(unit, 'unknown')}", file=out)
    if not all(states.get(unit, "").startswith("active ") for unit in services["camera"]):
        print("Start the cameras: mg400ctl start camera", file=out)
        return 1
    preload = run(
        ["curl", "-s", "--max-time", "3", PRELOAD], capture_output=True, text=True, check=False
    )
    names = [f"camera{number}" for number in range(1, len(devices) + 1)]
    absent = [name for name in names if name not in preload.stdout]
    if absent:
        print(f"streams  not loaded: {' '.join(absent)}", file=out)
        print("Run mg400ctl restart camera, wait 2 seconds, then check again.", file=out)
        return 1
    print("streams  all loaded", file=out)
    return 0


def as_service_user(host, settings, command, execvpe):
    """Replace this process with command, run as the service user from the code directory.

    runuser --pty gives the command its own terminal, so it cannot type into the root shell.
    With -g, the command gets only the service group, none of the account's other groups.
    The terminal and the mode switch need no panel token.
    """
    user = pwd.getpwuid(SERVICE_UID).pw_name
    group = grp.getgrgid(SERVICE_GID).gr_name
    runuser = shutil.which("runuser", path="/usr/sbin:/usr/bin:/sbin:/bin")
    if runuser is None:
        raise FileNotFoundError("runuser is missing. Install util-linux.")
    environment = {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        **{
            key: value
            for key, value in settings.items()
            if key.startswith("MG400_") and not key.endswith("_TOKEN") and value
        },
        **{key: os.environ[key] for key in PASSED if key in os.environ},
    }
    os.chdir(host.code)
    execvpe(runuser, ["runuser", "--pty", "-u", user, "-g", group, "--", *command], environment)


def main(
    argv=None,
    *,
    host=None,
    run=subprocess.run,
    execvpe=os.execvpe,
    out=sys.stdout,
    read_furnace_state=furnace_state,
):
    host = host or Host()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ORCHESTRATOR_COMMANDS:
        return orchestrator(host, argv, execvpe)
    try:
        registry = load_services(host.registry)
    except (OSError, ValueError) as error:
        print(f"Cannot read service registry: {error}", file=sys.stderr)
        return 1
    services = {name: entry["units"] for name, entry in registry.items()}
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("assets", help="Show manifest asset status without downloads or writes")
    archive = commands.add_parser(
        "backup", help="Back up host settings and data without process locks"
    )
    archive.add_argument("file", type=Path, metavar="FILE.tar")
    commands.add_parser("status", help="Show the state of every service")
    for action in ("start", "stop", "restart"):
        sub = commands.add_parser(action, help=f"{action.capitalize()} services")
        sub.add_argument("names", nargs="+", choices=[*services, "all"])
        if action != "start":
            sub.add_argument(
                "--force",
                action="store_true",
                help="Allow furnace shutdown during a sequence or when status cannot be checked",
            )
    logs = commands.add_parser("logs", help="Show the journal of one service")
    logs.add_argument("name", choices=list(services))
    logs.add_argument("-n", "--lines", type=int, default=50)
    logs.add_argument("-f", "--follow", action="store_true")
    commands.add_parser("terminal", help="Open the interactive robot terminal")
    mode = commands.add_parser("mode", help="Read the controller mode, or switch it to TCP")
    mode.add_argument("--switch-to-tcp", action="store_true")
    commands.add_parser("camera-url", help="Print the camera preview link with its key")
    commands.add_parser("camera-check", help="Check the camera devices, services and streams")
    token = commands.add_parser("token", help="Print the access token of a panel")
    token.add_argument(
        "panel", choices=[name for name, entry in registry.items() if entry["token"]]
    )
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        print("Run mg400ctl as root, for example: sudo mg400ctl status", file=sys.stderr)
        return 1
    if args.command == "backup":
        try:
            backup(host, args.file)
        except (OSError, ValueError, tarfile.TarError) as error:
            print(f"Cannot create backup: {error}", file=sys.stderr)
            return 1
        print(f"Backup created: {args.file}", file=out)
        return 0
    if args.command == "assets":
        try:
            manifest = assets.load_manifest(host.asset_manifest)
            states = [(asset, assets.asset_status(asset, host.root)) for asset in manifest.values()]
        except (OSError, ValueError) as error:
            print(f"Cannot read assets: {error}", file=sys.stderr)
            return 1
        for asset, state in states:
            print(f"{asset.name}  {state}  {assets.destination(asset, host.root)}", file=out)
        return int(any(state != "present" for _, state in states))
    try:
        settings = parse_settings(host.settings.read_text())
        if args.command in ("status", "start", "restart"):
            enabled = enabled_services(registry, settings.get("MG400_OPTIONAL_SERVICES", ""))
            if args.command != "status":
                disabled = [name for name in args.names if name != "all" and name not in enabled]
                if disabled:
                    raise ValueError(f"Optional services are not enabled: {', '.join(disabled)}")
            services = {name: entry["units"] for name, entry in enabled.items()}
        if args.command == "camera-check":
            devices = camera_devices(settings.get("MG400_CAMERA_DEVICES", ""))
        if args.command in ("terminal", "mode"):
            check_settings(settings)
            pwd.getpwuid(SERVICE_UID)
            grp.getgrgid(SERVICE_GID)
    except FileNotFoundError:
        print(f"{host.settings} is missing. Run deploy/install.py first.", file=sys.stderr)
        return 1
    except KeyError:
        print(f"Create a user and a group with ID {SERVICE_UID} first.", file=sys.stderr)
        return 1
    except ValueError as error:
        print(f"{host.settings}: {error}", file=sys.stderr)
        return 1

    if args.command == "status":
        return status(run, out, services)
    if args.command == "camera-check":
        return camera_check(host, devices, run, out, services)
    if args.command in ("start", "stop", "restart"):
        if (
            args.command != "start"
            and "furnace" in services
            and ("furnace" in args.names or "all" in args.names)
            and not args.force
        ):
            try:
                check_furnace_shutdown(settings, read_state=read_furnace_state)
            except (OSError, ValueError, http.client.HTTPException) as error:
                print(
                    f"Furnace shutdown refused: {error}. "
                    "Use --force only after coordinating heat and gas shutdown.",
                    file=sys.stderr,
                )
                return 1
        if args.command != "start" and any(name in ("web", "all") for name in args.names):
            print(
                "The web panel can take up to 60 seconds to confirm that the arm stopped.", file=out
            )
        return run(
            ["systemctl", args.command, *units(args.names, args.command, services)]
        ).returncode
    if args.command == "logs":
        command = ["journalctl", "--no-pager", "-n", str(args.lines)]
        for unit in services[args.name]:
            command += ["-u", unit]
        return run(command + (["-f"] if args.follow else [])).returncode
    if args.command == "terminal":
        program = host.code / ".venv/bin/mg400-robot"
        feedback = host.data / "work/gripper_feedback.json"
        as_service_user(
            host, settings, [str(program), "--gripper-feedback", str(feedback)], execvpe
        )
    elif args.command == "mode":
        command = [
            str(host.code / ".venv/bin/python"),
            str(host.code / "scripts/mg400_control_mode.py"),
            "--backup-dir",
            str(host.data / "work/control-mode"),
        ]
        as_service_user(host, settings, command + ["--switch-to-tcp"] * args.switch_to_tcp, execvpe)
    elif args.command == "camera-url":
        key = (host.data / "camera/preview.key").read_text().strip()
        bind = settings.get("MG400_CAMERA_BIND") or "127.0.0.1"
        print(f"http://{bind}:{CAMERA_PORT}/{key}/", file=out)
    elif args.command == "token":
        value = settings.get(registry[args.panel]["token"])
        if not value:
            print("No token is set. Run deploy/install.py to create one.", file=sys.stderr)
            return 1
        print(value, file=out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
