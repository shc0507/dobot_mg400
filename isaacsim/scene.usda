#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 600
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "MG400" (
        prepend references = @./mg400_with_gripper.usd@
    )
    {
    }

    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cube "Ground"
    {
        color3f[] primvars:displayColor = [(0.29, 0.32, 0.35)]
        double size = 2
        float3 xformOp:scale = (1, 1, 0.01)
        double3 xformOp:translate = (0, 0, -0.012)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 700
    }

    def DistantLight "KeyLight"
    {
        float inputs:angle = 1
        float inputs:intensity = 1800
        float3 xformOp:rotateXYZ = (25, -35, -25)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 24
        float horizontalAperture = 29.382624
        float verticalAperture = 16.527725
        matrix4d xformOp:transform = ( (0.794357832977196, 0.607450107570797, -0, 0), (-0.231013776315864, 0.302094938259207, 0.924862845740086, 0), (0.5618080351330487, -0.7346720459432174, 0.3803008237823711, 0), (0.78, -0.85, 0.66, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

