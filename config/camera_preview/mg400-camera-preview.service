[Unit]
Description=MG400 camera preview
Requires=mg400-camera-capture.service
After=mg400-camera-capture.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mg400-camera-preview
ExecStart=/usr/bin/python3 /opt/mg400-camera-preview/preview.py 100.64.0.1
Restart=on-failure
RestartSec=3
UMask=0077
