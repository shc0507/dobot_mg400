#usda 1.0
(
    defaultPrim = "MG400"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MG400" (
    doc = """Add movable PGEA jaws for measured-position display in the MG400 USD asset.

Run: uv run --group usd python scripts/build_isaac_mirror.py

Joint frames define each jaw's movement for the mirror code. This layer adds
no rigid bodies, masses, drives or collision geometry. Zero travel preserves
the open CAD pose. Each jaw moves inward by up to 5 mm.
"""
    prepend references = @./mg400_with_gripper.usd@
)
{
    def Xform "pgea_housing"
    {
        matrix4d xformOp:transform = ( (2.220446049250313e-16, 1, 0, 0), (-1, 2.220446049250313e-16, 0, 0), (0, 0, 1, 0), (0.2784487429828484, -1.2437811020005185e-7, 0.353251164344716, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    over "joints"
    {
        def PhysicsFixedJoint "pgea_housing_mount"
        {
            rel physics:body0 = </MG400/mg400_end_effector_flange>
            rel physics:body1 = </MG400/pgea_housing>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsPrismaticJoint "pgea_left_slide"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </MG400/pgea_housing>
            rel physics:body1 = </MG400/pgea_left_jaw>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.005
        }

        def PhysicsPrismaticJoint "pgea_right_slide"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </MG400/pgea_housing>
            rel physics:body1 = </MG400/pgea_right_jaw>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.005
        }
    }

    def Xform "pgea_left_jaw"
    {
        matrix4d xformOp:transform = ( (2.220446049250313e-16, 1, 0, 0), (-1, 2.220446049250313e-16, 0, 0), (0, 0, 1, 0), (0.2784487429828484, -1.2437811020005185e-7, 0.353251164344716, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]

        def Mesh "visual_pgea_jaw_left" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.00575, -0.016, -0.089), (0.00525, 0.0106, -0.0715)]
