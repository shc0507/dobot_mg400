[Unit]
Description=Microscope control and recording service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
SupplementaryGroups=dialout video
EnvironmentFile=/etc/mg400/mg400.env
# Keep the existing furnace credential for read-only recording metadata.
UnsetEnvironment=MG400_PANEL_TOKEN MG400_STAGE_TOKEN MG400_THERMAL_TOKEN MG400_VISION_TOKEN MG400_ORCH_TOKEN MG400_GATEWAY_TOKEN MG400_ORCH_ROBOT_TOKEN MG400_ORCH_STAGE_TOKEN MG400_ORCH_THERMAL_TOKEN MG400_ORCH_VISION_TOKEN MG400_ORCH_FURNACE_TOKEN MG400_ORCH_MICROSCOPE_TOKEN
Environment=LD_LIBRARY_PATH=/usr/local/lib/mg400
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/python -m microscope
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
# Do not kill accepted camera or motor cleanup while it is still draining.
TimeoutStopSec=infinity
