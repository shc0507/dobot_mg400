[Unit]
Description=Lab MCP gateway for reads and proposals
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
EnvironmentFile=/etc/mg400/mg400.env
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/python -m gateway
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
