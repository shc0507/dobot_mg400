[Unit]
Description=Stage motor panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
SupplementaryGroups=dialout
EnvironmentFile=/etc/mg400/mg400.env
# Drop the tokens that this service does not check.
UnsetEnvironment=MG400_PANEL_TOKEN
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/stage-panel
Restart=on-failure
RestartSec=3
# A startup refusal (exit status 2) is a configuration error: do not restart.
RestartPreventExitStatus=2
UMask=0077
TimeoutStopSec=30
