{
	admin off
	auto_https off
	persist_config off
	log default {
		exclude http.log.access http.log.error
	}
}

(instrument) {
	reverse_proxy {args[0]} {
		# Preserve the browser origin, including its port.
		header_up Host {http.request.hostport}
		header_up -Forwarded
		header_up X-Forwarded-Host {http.request.hostport}
		header_up X-Forwarded-For {http.request.remote.host}
		header_up -X-Real-IP
		transport http {
			versions 1.1
			dial_timeout 2s
			response_header_timeout 60s
			read_timeout 60s
		}
	}
}

http://:@PROXY_PORT@ {
	bind @PROXY_BIND@
	# The Lab Console is the only page. The camera streams feed its Cameras workspace.
	redir / /lab/ 302
	@bare path /camera /lab
	redir @bare {http.request.uri.path}/ 308
	# /camera/<view>.mjpeg and /camera/<view>.jpg reach the preview as /<view>.mjpeg and /<view>.jpg.
	handle_path /camera/* {
		import instrument 127.0.0.1:1985
	}
	handle /lab/* {
		import instrument 127.0.0.1:@ORCH_PORT@
	}
	handle {
		respond "Not found" 404
	}
}
