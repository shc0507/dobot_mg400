# Stage Arduino. Keep its /dev/serial/by-id identity.
# ModemManager must not probe this serial port: its AT bytes corrupt the next command.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="1453230313235111D1E0", MODE="0660", GROUP="@SERVICE_GROUP@", ENV{ID_MM_DEVICE_IGNORE}="1"
