# MG400 hardware settings for this host: /etc/mg400/mg400.env.
# Services read this file when they start. Restart a service after a change.
# An empty value means the default. The installer adds missing settings and
# never changes a value that is set. One surrounding quote pair is allowed.
# Backslashes are refused. Inner double quotes are allowed only in the two
# single-quoted furnace JSON objects below.

# Robot address. Empty: [robot].host in config/robot.toml.
MG400_ROBOT_HOST=
# Robot speed cap: integer percentages from 1 to 100. Empty: 1.
MG400_ROBOT_MAX_SPEED_L=
MG400_ROBOT_MAX_ACC_L=
# Measured tool offset for console Cartesian motion and station teaching.
MG400_ORCH_TOOL_FILE=/var/lib/mg400/robot/tool.toml

# Stage Arduino in /dev/serial/by-id/. Empty: the panel offers every serial port.
MG400_STAGE_SERIAL=

# One to four distinct /dev/v4l/by-path/... devices, separated by commas.
# Empty: cameras are off.
MG400_CAMERA_DEVICES=
# Optional WIDTHxHEIGHT@FPS list: one AC410 MJPEG mode per device.
# Empty: 640x480@30, except the microscope side stream, which uses 3840x2160@30.
MG400_CAMERA_MODES=

# Vision model and device. Empty device: CUDA when available, otherwise CPU.
MG400_VISION_WEIGHTS=/var/lib/mg400/models/chip-arm-yolo26s-seg-v1.pt
MG400_VISION_DEVICE=

# Microscope. The side stream is camera1 to camera4: the AC410 at the microscope side.
MG400_MICROSCOPE_SIDE_STREAM=
MG400_MICROSCOPE_SERIAL=
# Toupcam selection: set only one. Both empty select camera index 0.
MG400_TOUPCAM_SERIAL=
MG400_TOUPCAM_INDEX=
# Owner-measured focus limits and switch positions (H-06). Manual zero is at
# clearance, so SWITCH_FOCUS must be 0 when HOME_SWITCH is 0.
MG400_MICROSCOPE_SWITCH_FOCUS=
MG400_MICROSCOPE_HOME_SWITCH=
MG400_MICROSCOPE_FOCUS_LIMITS=
# Turret window: integer 0 to 20 full steps. 0 keeps clearance.
MG400_MICROSCOPE_NUDGE_STEPS=0

# Furnace and gas controller in /dev/serial/by-id/.
MG400_FURNACE_SERIAL=
MG400_MFC_SERIAL=
# Slave address 1 to 247.
MG400_FURNACE_SLAVE=1
# Caps: temperature at most 1000 C, ramp at most 100 C/min.
MG400_FURNACE_MAX_C=1000
MG400_FURNACE_MAX_RAMP=100
# Gas labels: single-quoted JSON object with keys 0, 1, 2, for example
# '{"0": "Ar", "1": "H2", "2": "N2"}'. Empty: channels are named Gas 1 to Gas 3.
MG400_FURNACE_GAS_MAP=
# Gas after orphan grace, cooling or uncertain recovery: channel-to-percent JSON. Empty: all off.
MG400_FURNACE_IDLE_GAS=

# Optional services from deploy/services.toml, separated by commas: vision, thermal,
# orch, gateway, proxy. Stop a service before you remove it.
MG400_OPTIONAL_SERVICES=

# Proxy address on the VPN: one numeric address, never a wildcard.
MG400_PROXY_BIND=127.0.0.1
MG400_PROXY_PORT=8080
