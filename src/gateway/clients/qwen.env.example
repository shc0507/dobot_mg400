# Use a gateway token supplied separately by the owner. Do not copy mg400.env.
MG400_GATEWAY_URL=http://127.0.0.1:8773/mcp
# MG400_GATEWAY_TOKEN must already be set in this client's environment.

# An existing local OpenAI-compatible Qwen server, or an authenticated tunnel.
# Set this ID to the exact model name returned by that server.
QUMUS_DEFAULT_MODEL_ID=Qwen/Qwen3-8B
QUMUS_API_BASE=http://127.0.0.1:8000/v1
# Use a separate provider credential if the model server requires one.
QUMUS_API_KEY=unused
QUMUS_LLM_TIMEOUT=60
QUMUS_LLM_RETRIES=0
