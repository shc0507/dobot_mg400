 	if ((ctrl->dwMaxPayloadTransferSize & 0xffff0000) == 0xffff0000)
 		ctrl->dwMaxPayloadTransferSize &= ~0xffff0000;
 
+	/*
+	 * Local patch: many MJPEG cameras request the largest isochronous
+	 * packet size for every frame size above VGA. With mjpeg_bpp set
+	 * (thousandths of a byte per pixel), estimate the bandwidth from the
+	 * frame size and rate instead, and never request more than the device.
+	 */
+	if ((format->flags & UVC_FMT_FLAG_COMPRESSED) && uvc_mjpeg_bpp &&
+	    stream->intf->num_altsetting > 1 &&
+	    stream->dev->udev->speed >= USB_SPEED_HIGH) {
+		u32 interval = (ctrl->dwFrameInterval > 100000)
+			     ? ctrl->dwFrameInterval
+			     : frame->dwFrameInterval[0];
+		u64 est = (u64)frame->wWidth * frame->wHeight * uvc_mjpeg_bpp;
+
+		est = div_u64(est * 10000000, interval);	/* milli-bytes/s */
+		est = div_u64(est, 1000 * 8000) + 12;		/* bytes/microframe */
+		if (est < ctrl->dwMaxPayloadTransferSize) {
+			uvc_dbg(stream->dev, VIDEO,
+				"mjpeg_bpp: payload %u -> %llu B\n",
+				ctrl->dwMaxPayloadTransferSize, est);
+			ctrl->dwMaxPayloadTransferSize = est;
+		}
+	}
+
