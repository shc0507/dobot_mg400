# MG400 settings for this host: /etc/mg400/mg400.env, readable by root only.
# Services read this file when they start. Restart a service after a change.
# Unless marked required, an empty value means the default.
# MG400_CONTROLLER_LOCK_DIR must be set.
# The installer adds missing settings and fills empty *_TOKEN values. It never
# changes a value that is set. Do not use quotes or backslashes in values,
# except the two single-quoted furnace JSON objects described below.

# Robot address. Empty: [robot].host in config/robot.toml.
MG400_ROBOT_HOST=
# Execute-command limits, integer percentages from 1 to 100. Empty: 1.
# Without an explicit command speed, SpeedL=1 and AccL=1 remain unchanged.
MG400_ROBOT_MAX_SPEED_L=
MG400_ROBOT_MAX_ACC_L=
# Required. All programs that connect to the robot share this lock directory.
MG400_CONTROLLER_LOCK_DIR=/var/lib/mg400/locks

# Web panel. A bind address other than localhost needs the token.
MG400_PANEL_BIND=127.0.0.1
MG400_PANEL_PORT=8766
MG400_PANEL_TOKEN=

# Camera preview on port 1985. Three /dev/v4l/by-path/... devices, separated by
# commas. Empty: cameras are off.
MG400_CAMERA_BIND=127.0.0.1
MG400_CAMERA_DEVICES=

# Stage panel. MG400_STAGE_SERIAL is the Arduino in /dev/serial/by-id/.
MG400_STAGE_BIND=127.0.0.1
MG400_STAGE_PORT=8767
MG400_STAGE_TOKEN=
MG400_STAGE_SERIAL=

# Optional furnace service. Serial devices must use stable /dev/serial/by-id/ paths.
# Set the serial paths before enabling furnace in MG400_OPTIONAL_SERVICES.
MG400_FURNACE_BIND=127.0.0.1
MG400_FURNACE_PORT=8769
MG400_FURNACE_BASE_PATH=/
MG400_FURNACE_TOKEN=
MG400_FURNACE_SERIAL=
MG400_MFC_SERIAL=
# Slave address 1..247. Caps: temperature greater than 0, at most 1000 C; ramp greater than 0, at most 100 C/min.
MG400_FURNACE_SLAVE=1
MG400_FURNACE_MAX_C=1000
MG400_FURNACE_MAX_RAMP=100
# Minutes before an open-ended setpoint stops after loss of its controlling client.
MG400_FURNACE_ORPHAN_GRACE_MIN=15
# Operator-supplied channel labels: single-quoted JSON object with keys 0, 1, 2.
# Empty means gas commands are refused. Do not invent gas identities or capacities.
# IDLE_GAS applies after orphan grace, cooling, or uncertain recovery.
# It is a channel-to-percent JSON object; empty means all off.
# Use literal double quotes inside single quotes, with no escapes or apostrophes.
MG400_FURNACE_GAS_MAP=
MG400_FURNACE_IDLE_GAS=

# Optional service names from deploy/services.toml, separated by commas.
# Empty: prepare only the mandatory services. Stop a service before removing it.
MG400_OPTIONAL_SERVICES=

# Station teaching requires measured tool offset and explicit fingertip workspace bounds.
# Required for station commands. Leave bounds empty until the operator supplies them.
MG400_ORCH_TOOL_FILE=/var/lib/mg400/tool.toml
MG400_ORCH_STATIONS_FILE=/var/lib/mg400/stations.toml
# Required before pick/transfer: explicit pre-grip opening, integer 0..1000, greater than grip.
MG400_ORCH_PRE_GRIP=
MG400_ORCH_X_MIN_MM=
MG400_ORCH_X_MAX_MM=
MG400_ORCH_Y_MIN_MM=
MG400_ORCH_Y_MAX_MM=
MG400_ORCH_Z_MIN_MM=
MG400_ORCH_Z_MAX_MM=
MG400_ORCH_R_MIN_DEG=
MG400_ORCH_R_MAX_DEG=
