[Unit]
Description=Vision inference service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
# go2rtc owns the cameras. Vision reads its loopback streams.
EnvironmentFile=/etc/mg400/mg400.env
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv-vision/bin/python -m vision
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
TimeoutStopSec=30
