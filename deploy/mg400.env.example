# MG400 settings for this host: /etc/mg400/mg400.env, readable by root only.
# Services read this file when they start. Restart a service after a change.
# An empty value means the default. The installer adds missing settings and
# fills empty *_TOKEN values. It never changes a value that is set.

# Robot address. Empty: [robot].host in config/robot.toml.
MG400_ROBOT_HOST=
# All programs that connect to the robot share this lock directory.
MG400_CONTROLLER_LOCK_DIR=/var/lib/mg400/locks

# Web panel. A bind address other than localhost needs the token.
MG400_PANEL_BIND=127.0.0.1
MG400_PANEL_PORT=8766
MG400_PANEL_TOKEN=

# Camera preview on port 1985. Three /dev/v4l/by-path/... devices, separated by
# commas. Empty: cameras are off.
MG400_CAMERA_BIND=127.0.0.1
MG400_CAMERA_DEVICES=

# Stage panel. MG400_STAGE_SERIAL is the Arduino in /dev/serial/by-id/.
MG400_STAGE_BIND=127.0.0.1
MG400_STAGE_PORT=8767
MG400_STAGE_TOKEN=
MG400_STAGE_SERIAL=
