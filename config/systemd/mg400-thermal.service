[Unit]
Description=Thermal Master P1 camera service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
# USB access comes from the thermal udev rule and the primary group.
EnvironmentFile=/etc/mg400/mg400.env
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/thermal-cam
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
TimeoutStopSec=30
