# MG400 settings for this host: /etc/mg400/mg400.env, readable by root only.
# Services read this file when they start. Restart a service after a change.
# Unless marked required, an empty value means the default.
# MG400_CONTROLLER_LOCK_DIR must be set.
# The installer adds missing settings and fills empty service *_TOKEN values. It never
# changes a value that is set. One surrounding quote pair is allowed.
# Backslashes are refused. Inner double quotes are allowed only in the two
# single-quoted furnace JSON objects described below.
# Empty orchestrator downstream aliases copy their matching service token instead.

# Robot address. Empty: [robot].host in config/robot.toml.
MG400_ROBOT_HOST=
# Execute-command limits, integer percentages from 1 to 100. Empty: 1.
# Without an explicit command speed, SpeedL=1 and AccL=1 remain unchanged.
MG400_ROBOT_MAX_SPEED_L=
MG400_ROBOT_MAX_ACC_L=
# Required. All programs that connect to the robot share this lock directory.
MG400_CONTROLLER_LOCK_DIR=/var/lib/mg400/locks

# Web panel. A bind address other than localhost needs the token.
MG400_PANEL_BIND=127.0.0.1
MG400_PANEL_PORT=8766
# Native page/API prefix. Use /robot/ with the optional proxy.
MG400_PANEL_BASE_PATH=/
MG400_PANEL_TOKEN=

# Camera preview on port 1985. One to four distinct /dev/v4l/by-path/... devices,
# separated by commas. Empty: cameras are off.
MG400_CAMERA_BIND=127.0.0.1
MG400_CAMERA_DEVICES=
# Optional WIDTHxHEIGHT@FPS list: one supported AC410 MJPEG mode per device.
# Do not combine it with MG400_CAMERA_CAPTURE_SIZES. Camera 4 (tray): 1280x720@30.
MG400_CAMERA_MODES=
# Legacy WIDTHxHEIGHT list in the same order, at 30 fps. With both lists blank,
# use 640x480, except the microscope side stream, which uses 3840x2160.
# H-21 checks USB bandwidth. Preload only modes up to 640x480.
MG400_CAMERA_CAPTURE_SIZES=

# Optional vision service. Selecting vision installs its isolated GPU environment
# and verified model asset. go2rtc remains the camera owner.
MG400_VISION_BIND=127.0.0.1
MG400_VISION_PORT=8771
MG400_VISION_TOKEN=
MG400_VISION_WEIGHTS=/var/lib/mg400/models/chip-arm-yolo26s-seg-v1.pt
# Empty selects CUDA when available, otherwise CPU. Use cpu to select CPU explicitly.
MG400_VISION_DEVICE=
# CUDA memory fraction, greater than 0 and at most 1, applied before model loading.
MG400_VISION_GPU_FRACTION=0.15

# Camera-to-robot calibration. The installer creates the default private directory.
MG400_VISION_CALIBRATION_DIR=/var/lib/mg400/calibration/cameras
MG400_VISION_TAG_HEIGHT_MM=100
MG400_VISION_TAG_TIP_MM=246
# Error threshold in millimetres: greater than 0 and at most 1.
MG400_VISION_CALIBRATION_RMS_MM=1
# Drift check: marker 4 pixel limit, greater than 0 and at most 3.
MG400_ORCH_DRIFT_LIMIT_PX=3
# Owner-measured, no-tool flange poses for 2 to 4 tray ArUco marker centers.
MG400_CAMERA_CALIBRATION_REFERENCES=/var/lib/mg400/calibration/cameras/references.toml

# Optional microscope service. The side stream is camera1 through camera4 from
# go2rtc, mapped by the device list to the AC410 at the microscope side.
MG400_MICROSCOPE_BIND=127.0.0.1
MG400_MICROSCOPE_PORT=8770
MG400_MICROSCOPE_BASE_PATH=/
MG400_MICROSCOPE_TOKEN=
MG400_MICROSCOPE_SIDE_STREAM=
MG400_MICROSCOPE_SERIAL=
# Toupcam selection: set only one. Both blank select camera index 0.
MG400_TOUPCAM_SERIAL=
MG400_TOUPCAM_INDEX=
MG400_MICROSCOPE_CALIBRATION_DIR=/var/lib/mg400/calibration/microscope
# Required for real motion. Use the owner's H-06 measurements; no guessed limits.
# Manual zero is at clearance, so SWITCH_FOCUS must be 0 when HOME_SWITCH is 0.
MG400_MICROSCOPE_SWITCH_FOCUS=
MG400_MICROSCOPE_HOME_SWITCH=
MG400_MICROSCOPE_FOCUS_LIMITS=
# H-06 measured turret window: integer 0..20 full steps. Blank or 0 keeps clearance.
# Positive values apply only to supervised objective/light calibration with --focus-start.
# Experiments and full objective switches still require clearance. Never guess this value.
MG400_MICROSCOPE_NUDGE_STEPS=0
# Read-only furnace metadata. Include its API base prefix when configured.
# Use the furnace bind address and port. docs/microscope.en.md gives the Olares value.
# The microscope uses the existing MG400_FURNACE_TOKEN; do not create a token alias.
MG400_MICROSCOPE_FURNACE_URL=http://127.0.0.1:8769/
# Optional absolute mounted archive. Empty retains recordings locally only.
MG400_FURNACE_ARCHIVE_DIR=

# Stage panel. MG400_STAGE_SERIAL is the Arduino in /dev/serial/by-id/.
MG400_STAGE_BIND=127.0.0.1
MG400_STAGE_PORT=8767
# Native page/API prefix. The contract is beneath this prefix at contract/.
MG400_STAGE_BASE_PATH=/
MG400_STAGE_TOKEN=
MG400_STAGE_SERIAL=

# Optional thermal service. Selecting thermal installs its USB access rule.
# The service opens the camera at startup. Keep the default loopback bind unless
# VPN clients connect directly. Use /thermal/ with the optional proxy.
MG400_THERMAL_BIND=127.0.0.1
MG400_THERMAL_PORT=8768
MG400_THERMAL_BASE_PATH=/
MG400_THERMAL_TOKEN=

# Optional furnace service. Serial devices must use stable /dev/serial/by-id/ paths.
# Set the serial paths before enabling furnace in MG400_OPTIONAL_SERVICES.
MG400_FURNACE_BIND=127.0.0.1
MG400_FURNACE_PORT=8769
MG400_FURNACE_BASE_PATH=/
MG400_FURNACE_TOKEN=
MG400_FURNACE_SERIAL=
MG400_MFC_SERIAL=
# Slave address 1..247. Caps: temperature greater than 0, at most 1000 C; ramp greater than 0, at most 100 C/min.
MG400_FURNACE_SLAVE=1
MG400_FURNACE_MAX_C=1000
MG400_FURNACE_MAX_RAMP=100
# Minutes before an open-ended setpoint stops after loss of its controlling client.
MG400_FURNACE_ORPHAN_GRACE_MIN=15
# Operator-supplied channel labels: single-quoted JSON object with keys 0, 1, 2.
# Empty means gas commands are refused. Do not invent gas identities or capacities.
# IDLE_GAS applies after orphan grace, cooling, or uncertain recovery.
# It is a channel-to-percent JSON object; empty means all off.
# Use literal double quotes inside single quotes, with no escapes or apostrophes.
MG400_FURNACE_GAS_MAP=
MG400_FURNACE_IDLE_GAS=

# Optional service names from deploy/services.toml, separated by commas.
# Empty: prepare only the mandatory services. Stop a service before removing it.
MG400_OPTIONAL_SERVICES=

# Optional orchestrator HTTP service. Selecting orch prepares its runs/zones directories.
MG400_ORCH_BIND=127.0.0.1
MG400_ORCH_PORT=8772
MG400_ORCH_BASE_PATH=/
MG400_ORCH_TOKEN=
MG400_ORCH_RECIPES_DIR=/opt/mg400/recipes
MG400_ORCH_RUNS_DIR=/var/lib/mg400/runs
MG400_ORCH_TIMEOUT_S=2
# Explicit service URLs, including any mounted base path. Empty: not configured.
MG400_ORCH_ROBOT_URL=
MG400_ORCH_STAGE_URL=
MG400_ORCH_THERMAL_URL=
MG400_ORCH_VISION_URL=
MG400_ORCH_FURNACE_URL=
MG400_ORCH_MICROSCOPE_URL=
# The installer copies a blank alias from the matching direct service token.
# ROBOT copies MG400_PANEL_TOKEN. Unavailable source tokens leave aliases empty.
# Explicit nonempty aliases are preserved. Keep them synchronized after token rotation.
MG400_ORCH_ROBOT_TOKEN=
MG400_ORCH_STAGE_TOKEN=
MG400_ORCH_THERMAL_TOKEN=
MG400_ORCH_VISION_TOKEN=
MG400_ORCH_FURNACE_TOKEN=
MG400_ORCH_MICROSCOPE_TOKEN=

# Optional dashboard camera pages. Blank means unavailable; demo ignores these URLs.
# These explicit HTTP(S) page links are returned by the authenticated dashboard API.
# Never include instrument API bearer tokens, URL credentials, query parameters,
# fragments, spaces, control characters, or backslashes. A deliberately supplied
# camera page secret path is shared as configured; no secret paths are discovered.
# Do not copy private instrument endpoints. Each page keeps its own access rules.
MG400_DASH_CAMERA_URL=
MG400_DASH_THERMAL_URL=
MG400_DASH_MICROSCOPE_URL=

# Optional MCP gateway for reads and human-reviewed proposals. Always require its bearer token, including loopback.
# Reuse the explicit MG400_ORCH_*_URL/TOKEN aliases above for GET requests only.
# The server-side caller identifies this shared credential in the audit log.
MG400_GATEWAY_BIND=127.0.0.1
MG400_GATEWAY_PORT=8773
MG400_GATEWAY_TOKEN=
MG400_GATEWAY_CALLER=gateway-agent
MG400_GATEWAY_RUNS_DIR=/var/lib/mg400/runs
MG400_GATEWAY_RECIPES_DIR=/opt/mg400/recipes
# Blank disables proposal tools. Use direct HTTP loopback, including ORCH_BASE_PATH.
# The gateway token authenticates proposals only; keep it distinct from operator/device tokens.
MG400_GATEWAY_ORCH_URL=

# Station teaching requires measured tool offset and explicit fingertip workspace bounds.
# Required for station commands. Leave bounds empty until the operator supplies them.
MG400_ORCH_TOOL_FILE=/var/lib/mg400/robot/tool.toml
MG400_ORCH_STATIONS_FILE=/var/lib/mg400/robot/stations.toml
# Required before pick/transfer: explicit pre-grip opening, integer 0..1000, greater than grip.
MG400_ORCH_PRE_GRIP=
# Crucible skills require explicit limits and positions. -1 in a recipe means unset.
MG400_ORCH_CRUCIBLE_LOAD_MAX_C=
MG400_ORCH_CRUCIBLE_UNLOAD_MAX_C=
MG400_ORCH_CRUCIBLE_GRIP=
MG400_ORCH_CRUCIBLE_RELEASE=
# One explicit awake interval, 0 < seconds <= 60, covering the remaining step budget.
MG400_ORCH_CRUCIBLE_AWAKE_S=
MG400_ORCH_CRUCIBLE_MAX_AGE_S=
# Optional read-only ROI data for owned thermal rehearsal; never selects a device.
MG400_ORCH_CRUCIBLE_ROIS_FILE=
MG400_ORCH_X_MIN_MM=
MG400_ORCH_X_MAX_MM=
MG400_ORCH_Y_MIN_MM=
MG400_ORCH_Y_MAX_MM=
MG400_ORCH_Z_MIN_MM=
MG400_ORCH_Z_MAX_MM=
MG400_ORCH_R_MIN_DEG=
MG400_ORCH_R_MAX_DEG=

# Explicit zone owners and entry conditions. Prepare an owned 0750 directory first.
# Missing configuration refuses named zone entry.
MG400_ORCH_ZONES_FILE=/var/lib/mg400/zones/config.toml
# Durable occupancy. Retained claims require physical checks and audited recovery.
# Rehearsal never receives this production path; it owns temporary occupancy.
MG400_ORCH_ZONE_STATE_FILE=/var/lib/mg400/zones/occupancy.json

# Optional Caddy proxy. Add proxy to MG400_OPTIONAL_SERVICES and pass --caddy PATH.
# Use one numeric VPN address, never a wildcard. Upstream services stay on 127.0.0.1.
# Set web/stage prefixes to /robot/ and /stage/ before selecting proxy.
# Enabled thermal/furnace/orch use /thermal/, /furnace/, and /lab/. Their tokens remain required.
MG400_PROXY_BIND=127.0.0.1
MG400_PROXY_PORT=8080
