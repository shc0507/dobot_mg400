[Unit]
Description=Lab recipe orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
EnvironmentFile=/etc/mg400/mg400.env
WorkingDirectory=/opt/mg400
# The proxy serves the console at /lab/.
ExecStart=/opt/mg400/.venv/bin/python -m orchestrator serve --base-path /lab/
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
# Accepted operations must drain before stop confirmation and lease cleanup.
TimeoutStopSec=infinity
