# Model API configuration for natural-language control.
# Key may be blank for a custom chat_completions server that accepts no-key requests.
OPENAI_API_KEY=
# Use a model available to your account/server that supports function tools.
OPENAI_MODEL=
# responses (default, OpenAI) or chat_completions (OpenAI-compatible servers).
OPENAI_API_MODE=responses
# Optional server URL; include https:// and the API prefix, usually /v1.
# OPENAI_BASE_URL=https://your-server.example/v1
