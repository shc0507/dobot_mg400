#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 3600
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./scene.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    over "MG400" (
        references = @./mg400_grasp.usda@
    )
    {
    }

    over "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
    }
}

