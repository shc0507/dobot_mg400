# Pressure sensor Arduino (firmware/pressure-sensor) on the suction line. The robot service reads it.
# ModemManager must not probe this serial port: its AT bytes corrupt the next line.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="1453230313235111B180", MODE="0660", GROUP="@SERVICE_GROUP@", ENV{ID_MM_DEVICE_IGNORE}="1"
