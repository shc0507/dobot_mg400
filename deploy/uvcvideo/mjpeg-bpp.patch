+module_param_named(mjpeg_bpp, uvc_mjpeg_bpp, uint, 0644);
+MODULE_PARM_DESC(mjpeg_bpp, "MJPEG bandwidth estimate in 1/1000 byte per pixel (0 = use device value)");
