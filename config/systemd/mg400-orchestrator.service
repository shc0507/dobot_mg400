[Unit]
Description=Lab recipe orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
# Fixed defaults. The proxy serves the console at /lab/.
Environment=MG400_ORCH_BASE_PATH=/lab/
Environment=MG400_ORCH_ROBOT_URL=http://127.0.0.1:8766/
Environment=MG400_ORCH_STAGE_URL=http://127.0.0.1:8767/contract/
Environment=MG400_ORCH_THERMAL_URL=http://127.0.0.1:8768/
Environment=MG400_ORCH_FURNACE_URL=http://127.0.0.1:8769/
Environment=MG400_ORCH_MICROSCOPE_URL=http://127.0.0.1:8770/
Environment=MG400_ORCH_VISION_URL=http://127.0.0.1:8771/
EnvironmentFile=/etc/mg400/mg400.env
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/python -m orchestrator serve
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
# Accepted operations must drain before stop confirmation and lease cleanup.
TimeoutStopSec=infinity
