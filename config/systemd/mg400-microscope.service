[Unit]
Description=Microscope control and recording service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
SupplementaryGroups=dialout video
EnvironmentFile=/etc/mg400/mg400.env
Environment=LD_LIBRARY_PATH=/usr/local/lib/mg400
WorkingDirectory=/opt/mg400
ExecStart=/opt/mg400/.venv/bin/python -m microscope
Restart=on-failure
# Each start resets the Arduino, so retry less often.
RestartSec=10
# A startup refusal (exit status 2) is a configuration error: do not restart.
# A device, model or serving failure exits 1 and restarts.
RestartPreventExitStatus=2
UMask=0077
# Do not kill accepted camera or motor cleanup while it is still draining.
TimeoutStopSec=infinity
