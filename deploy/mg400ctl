#!/usr/bin/python3
"""Control host services with mg400ctl or labctl. Run as root, for example: sudo mg400ctl status

terminal and mode run as the service user (UID 1000) with the settings from
/etc/mg400/mg400.env, so they share the robot connection lock with the panels.
"""

import argparse
import grp
import os
import pwd
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import assets  # noqa: E402
from install import (  # noqa: E402
    SERVICE_GID,
    SERVICE_UID,
    Host,
    camera_devices,
    check_settings,
    enabled_services,
    load_services,
    parse_settings,
)

WATCHER = "mg400-gripper-collector.path"
CAMERA_PORT = 1985
PRELOAD = "http://127.0.0.1:1984/api/preload"
PASSED = ("TERM", "COLORTERM", "LANG", "LC_ALL", "LC_CTYPE")


def units(names, action, services):
    if "all" in names:
        names = list(services)
    result = []
    for name in names:
        # Starting the preview also starts the capture. Stopping either stops both.
        chosen = services[name][:1] if action == "start" else services[name]
        result.extend(unit for unit in chosen if unit not in result)
    return result


def unit_states(run, chosen):
    """Return {unit: "ActiveState (SubState)"} for the units that systemd knows."""
    shown = run(
        ["systemctl", "show", "--property=Id,ActiveState,SubState", *chosen],
        capture_output=True,
        text=True,
        check=False,
    )
    states = {}
    for block in shown.stdout.strip().split("\n\n"):
        values = dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
        states[values.get("Id")] = f"{values.get('ActiveState')} ({values.get('SubState')})"
    return states


def status(run, out, services):
    rows = [(name, unit) for name, chosen in services.items() for unit in chosen]
    rows.append(("collector", WATCHER))
    states = unit_states(run, [unit for _, unit in rows])
    for name, unit in rows:
        print(f"{name:<10} {unit:<34} {states.get(unit, 'unknown')}", file=out)
    return 0


def camera_check(host, devices, run, out, services):
    """Check the cameras from the USB devices up to the capture streams. Return 0 if all work.

    A service in the active state only shows that its process runs, so check the devices first.
    """
    if not devices:
        print("Cameras are off: MG400_CAMERA_DEVICES is empty.", file=out)
        return 0
    missing = []
    for number, device in enumerate(devices, 1):
        path = host.dev / Path(device).relative_to("/dev")
        if path.exists():
            print(f"camera{number}  ok       {device} -> /dev/{path.resolve().name}", file=out)
        else:
            print(f"camera{number}  missing  {device}", file=out)
            missing.append(device)
    found = sorted(host.dev.glob("v4l/by-path/*-video-index0"))
    others = [f"/dev/{path.relative_to(host.dev)}" for path in found]
    others = [device for device in others if device not in devices]
    for device in others:
        print(f"other    present  {device}", file=out)
    if missing:
        if others:
            print("A camera is on another USB port. Connect it to its configured port.", file=out)
        elif not found:
            print(
                "No camera is detected. Check the USB hub, its cable and power: lsusb -t", file=out
            )
        else:
            print("Check the cable of each missing camera: lsusb -t", file=out)
        print("Restarting the camera services does not fix a missing USB device.", file=out)
        return 1

    states = unit_states(run, services["camera"])
    for unit in services["camera"]:
        print(f"service  {unit:<30} {states.get(unit, 'unknown')}", file=out)
    if not all(states.get(unit, "").startswith("active ") for unit in services["camera"]):
        print("Start the cameras: mg400ctl start camera", file=out)
        return 1
    preload = run(
        ["curl", "-s", "--max-time", "3", PRELOAD], capture_output=True, text=True, check=False
    )
    names = [f"camera{number}" for number in range(1, len(devices) + 1)]
    absent = [name for name in names if name not in preload.stdout]
    if absent:
        print(f"streams  not loaded: {' '.join(absent)}", file=out)
        print("Run mg400ctl restart camera, wait 2 seconds, then check again.", file=out)
        return 1
    print("streams  all loaded", file=out)
    return 0


def as_service_user(host, settings, command, execvpe):
    """Replace this process with command, run as the service user from the code directory.

    runuser --pty gives the command its own terminal, so it cannot type into the root shell.
    With -g, the command gets only the service group, none of the account's other groups.
    The terminal and the mode switch need no panel token.
    """
    user = pwd.getpwuid(SERVICE_UID).pw_name
    group = grp.getgrgid(SERVICE_GID).gr_name
    runuser = shutil.which("runuser", path="/usr/sbin:/usr/bin:/sbin:/bin")
    if runuser is None:
        raise FileNotFoundError("runuser is missing. Install util-linux.")
    environment = {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        **{
            key: value
            for key, value in settings.items()
            if key.startswith("MG400_") and not key.endswith("_TOKEN") and value
        },
        **{key: os.environ[key] for key in PASSED if key in os.environ},
    }
    os.chdir(host.code)
    execvpe(runuser, ["runuser", "--pty", "-u", user, "-g", group, "--", *command], environment)


def main(argv=None, *, host=None, run=subprocess.run, execvpe=os.execvpe, out=sys.stdout):
    host = host or Host()
    try:
        registry = load_services(host.registry)
    except (OSError, ValueError) as error:
        print(f"Cannot read service registry: {error}", file=sys.stderr)
        return 1
    services = {name: entry["units"] for name, entry in registry.items()}
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("assets", help="Show manifest asset status without downloads or writes")
    commands.add_parser("status", help="Show the state of every service")
    for action in ("start", "stop", "restart"):
        sub = commands.add_parser(action, help=f"{action.capitalize()} services")
        sub.add_argument("names", nargs="+", choices=[*services, "all"])
    logs = commands.add_parser("logs", help="Show the journal of one service")
    logs.add_argument("name", choices=list(services))
    logs.add_argument("-n", "--lines", type=int, default=50)
    logs.add_argument("-f", "--follow", action="store_true")
    commands.add_parser("terminal", help="Open the interactive robot terminal")
    mode = commands.add_parser("mode", help="Read the controller mode, or switch it to TCP")
    mode.add_argument("--switch-to-tcp", action="store_true")
    commands.add_parser("camera-url", help="Print the camera preview link with its key")
    commands.add_parser("camera-check", help="Check the camera devices, services and streams")
    token = commands.add_parser("token", help="Print the access token of a panel")
    token.add_argument(
        "panel", choices=[name for name, entry in registry.items() if entry["token"]]
    )
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        print("Run mg400ctl as root, for example: sudo mg400ctl status", file=sys.stderr)
        return 1
    if args.command == "assets":
        try:
            manifest = assets.load_manifest(host.asset_manifest)
            states = [(asset, assets.asset_status(asset, host.root)) for asset in manifest.values()]
        except (OSError, ValueError) as error:
            print(f"Cannot read assets: {error}", file=sys.stderr)
            return 1
        for asset, state in states:
            print(f"{asset.name}  {state}  {assets.destination(asset, host.root)}", file=out)
        return int(any(state != "present" for _, state in states))
    try:
        settings = parse_settings(host.settings.read_text())
        if args.command in ("status", "start", "restart"):
            enabled = enabled_services(registry, settings.get("MG400_OPTIONAL_SERVICES", ""))
            if args.command != "status":
                disabled = [name for name in args.names if name != "all" and name not in enabled]
                if disabled:
                    raise ValueError(f"Optional services are not enabled: {', '.join(disabled)}")
            services = {name: entry["units"] for name, entry in enabled.items()}
        if args.command == "camera-check":
            devices = camera_devices(settings.get("MG400_CAMERA_DEVICES", ""))
        if args.command in ("terminal", "mode"):
            check_settings(settings)
            pwd.getpwuid(SERVICE_UID)
            grp.getgrgid(SERVICE_GID)
    except FileNotFoundError:
        print(f"{host.settings} is missing. Run deploy/install.py first.", file=sys.stderr)
        return 1
    except KeyError:
        print(f"Create a user and a group with ID {SERVICE_UID} first.", file=sys.stderr)
        return 1
    except ValueError as error:
        print(f"{host.settings}: {error}", file=sys.stderr)
        return 1

    if args.command == "status":
        return status(run, out, services)
    if args.command == "camera-check":
        return camera_check(host, devices, run, out, services)
    if args.command in ("start", "stop", "restart"):
        if args.command != "start" and any(name in ("web", "all") for name in args.names):
            print(
                "The web panel can take up to 60 seconds to confirm that the arm stopped.", file=out
            )
        return run(
            ["systemctl", args.command, *units(args.names, args.command, services)]
        ).returncode
    if args.command == "logs":
        command = ["journalctl", "--no-pager", "-n", str(args.lines)]
        for unit in services[args.name]:
            command += ["-u", unit]
        return run(command + (["-f"] if args.follow else [])).returncode
    if args.command == "terminal":
        program = host.code / ".venv/bin/mg400-robot"
        feedback = host.data / "work/gripper_feedback.json"
        as_service_user(
            host, settings, [str(program), "--gripper-feedback", str(feedback)], execvpe
        )
    elif args.command == "mode":
        command = [
            str(host.code / ".venv/bin/python"),
            str(host.code / "scripts/mg400_control_mode.py"),
            "--backup-dir",
            str(host.data / "work/control-mode"),
        ]
        as_service_user(host, settings, command + ["--switch-to-tcp"] * args.switch_to_tcp, execvpe)
    elif args.command == "camera-url":
        key = (host.data / "camera/preview.key").read_text().strip()
        bind = settings.get("MG400_CAMERA_BIND") or "127.0.0.1"
        print(f"http://{bind}:{CAMERA_PORT}/{key}/", file=out)
    elif args.command == "token":
        value = settings.get(registry[args.panel]["token"])
        if not value:
            print("No token is set. Run deploy/install.py to create one.", file=sys.stderr)
            return 1
        print(value, file=out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
