# AC410 cameras share a serial. Keep their /dev/v4l/by-path identities.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="f326", ATTRS{idProduct}=="1306", ATTRS{serial}=="HU12321178", MODE="0660", GROUP="@SERVICE_GROUP@"
# The wrist camera needs a USB reset before each stream start. The reset opens its USB device node.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="32e4", ATTR{idProduct}=="3415", ATTR{serial}=="2023121018", MODE="0660", GROUP="@SERVICE_GROUP@"
