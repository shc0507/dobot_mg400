[Unit]
Description=MG400 service reverse proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=1000
Group=1000
EnvironmentFile=/etc/mg400/mg400.env
# Do not pass outbound proxy settings to Caddy.
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
WorkingDirectory=/opt/mg400
ExecStart=/usr/local/lib/mg400/caddy run --config /etc/mg400/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
TimeoutStopSec=30
