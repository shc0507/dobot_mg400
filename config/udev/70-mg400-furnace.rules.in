# Furnace and gas serial controllers.
# ModemManager must not probe this serial port: its AT bytes corrupt the next command.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="DU0DT9G8", MODE="0660", GROUP="@SERVICE_GROUP@", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="ABBCE4JW", MODE="0660", GROUP="@SERVICE_GROUP@", ENV{ID_MM_DEVICE_IGNORE}="1"
